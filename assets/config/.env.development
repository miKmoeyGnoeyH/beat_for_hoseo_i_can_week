# 앱스토어 ID
APPSTORE_ID=6633415792

# 구글플레이 ID
GOOGLEPLAY_ID=com.dclab.beat

# Base URL
BASE_URL=http://192.168.1.23:8080/server

# 닉네임 중복확인
VALIDATE_NICKNAME=${BASE_URL}/auth/member/nickname-check

# 이메일 인증 요청
REQUEST_EMAIL=${BASE_URL}/auth/email/request

# 이메일 인증 완료 요청(회원가입)
VERIFY_EMAIL=${BASE_URL}/auth/email/verify

# 이메일 인증코드 확인(비밀번호 변경)
CHECK_AUTHCODE=${BASE_URL}/auth/email/check

# 회원가입
SIGN_UP=${BASE_URL}/auth/member/sign-up

# 로그인
SIGN_IN=${BASE_URL}/auth/member/sign-in

# 포인트 확인
POINT=${BASE_URL}/member/status

# 퀘스트 리스트
QUEST_LIST=${BASE_URL}/member/quest/bingo/list

# 퀘스트 상세
QUEST_DETAIL=${BASE_URL}/member/quest/

# 프로필
PROFILE=${BASE_URL}/member/profile